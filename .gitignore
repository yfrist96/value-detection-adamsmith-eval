# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual env
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Mac
.DS_Store

# Models
models/
*.bin
*.pt
*.ckpt

# Data (optional – depends if you want to share it)
data/

# Experiment outputs: checkpoints and prediction dumps are far too large to
# version, but the metric logs that every number in the paper is computed from
# are small (well under a megabyte) and are tracked, so the reported results can
# be checked without re-running any training.
experiments/*
!experiments/results/
experiments/results/*
!experiments/results/*.csv
!experiments/results/*.json
!experiments/results/*/
experiments/results/*/*
!experiments/results/*/metrics.csv
!experiments/results/*/seed_*/
experiments/results/*/seed_*/*
!experiments/results/*/seed_*/metrics.csv

# Few-shot LLM experiment: the generation scripts and the exact prompt templates
# are tracked, because they are what makes the few-shot results reproducible. The
# per-item prediction dumps are co-author-owned interim data and stay untracked
# until they are released with the paper.
!experiments/fewshot/
experiments/fewshot/*
!experiments/fewshot/*.py
!experiments/fewshot/prompts/
!experiments/fewshot/prompts/*.txt

# Paper drafts (managed separately, and deliberately kept out of the artifact repo)
Paper/
paper_arr/
paper_arr_long/
paper_arr_no_ijh/
paper_arr_v2/

# LaTeX and tooling scratch
*.log
errors-paper.json

# Training timing logs, re-included after the *.log rule above (last match wins, so
# these must stay below it). They are the only evidence behind the wall-clock figures
# the paper reports: train_seeds_43_44.log gives 292.3 min for six runs, from which the
# "roughly 18 hours across 17 runs" figure is reconstructible, and train_ultra_45_46.log
# is the record of the one run in seventeen that diverged and is excluded. Both are a few
# kilobytes, contain no participant data, and use repository-relative paths only.
!experiments/train_seeds_43_44.log
!experiments/train_ultra_45_46.log
